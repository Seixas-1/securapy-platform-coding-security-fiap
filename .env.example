# Copie este arquivo para ".env" e troque todos os valores de exemplo.
# NUNCA commite o arquivo ".env" real (ele esta no .gitignore).

# --- Flask / API ---
FLASK_SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
JWT_SECRET=troque-este-segredo-jwt-por-outra-string-aleatoria
PORT=5000

# --- MongoDB (eventos e alertas) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=securapy_admin
MONGO_PASSWORD=troque-esta-senha
MONGO_DB=securapy

# --- MySQL (usuarios/operadores da plataforma) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=securapy
MYSQL_USER=securapy_app
MYSQL_PASSWORD=troque-esta-senha

# --- Usuario administrador inicial (criado por scripts/inicializar_banco.py) ---
ADMIN_EMAIL=admin@securapy.local
ADMIN_PASSWORD=troque-esta-senha-admin

# --- LLM (Modulo G) - opcional. Sem chave, o assistente usa fallback por regras ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
